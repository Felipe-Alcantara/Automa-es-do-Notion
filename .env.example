# Felixo Notion MCP — variáveis de ambiente (modelo).
#
# Copie este arquivo para `.env` na raiz do checkout e descomente só o que for usar. O
# `.env` é ignorado pelo git: nunca versione tokens nem chaves. Uma variável já definida
# no ambiente vence o valor do arquivo.
#
# Quem salva workspaces como perfis (`notion-tasks perfis adicionar <alias>`) não precisa
# de NOTION_TOKEN: o perfil ativo vence a variável de ambiente, silenciosamente.

# --- Notion -----------------------------------------------------------------------------

# Token de integração do Notion.
# Crie uma integração em https://www.notion.so/my-integrations, compartilhe o database ou
# a página alvo com ela e cole o token aqui. O token deve começar com "ntn_".
# NOTION_TOKEN=

# ID do database de tarefas padrão (opcional — pode ser passado por chamada).
# NOTION_DATABASE_ID=

# ID do database que recebe páginas de projetos importados do GitHub (opcional).
# NOTION_PROJECTS_DATABASE_ID=

# ID do database de relatórios diários, usado por `notion-tasks exportar-docx` quando
# --database não é informado (opcional — cai em NOTION_DATABASE_ID se ausente).
# NOTION_REPORTS_DATABASE_ID=

# Alias do perfil a usar nesta execução, em vez do perfil ativo (opcional).
# NOTION_PROFILE=

# --- GitHub (opcional) ------------------------------------------------------------------

# Token do GitHub: opcional para repositórios públicos, necessário para os privados.
# Prefira um token fine-grained com acesso somente de leitura aos repositórios usados.
# GITHUB_TOKEN=

# Contas (login, @handle ou URL, separadas por vírgula) que `notion-tasks atualizar-github`
# e o menu usam quando --contas não é informado.
# GITHUB_CONTAS=

# --- OpenRouter (opcional) --------------------------------------------------------------

# Chave da OpenRouter, usada só pela camada de IA (catálogo de modelos e copiloto).
# OPENROUTER_API_KEY=

# --- App local: servidor Django (opcional — só se usar o app web) -----------------------

# Chave secreta do Django. OBRIGATÓRIA fora do modo debug (DJANGO_DEBUG desligado).
# Em modo debug, uma chave de desenvolvimento é usada automaticamente.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# Liga o modo debug do Django (1/true/yes/on). Padrão: desligado.
# DJANGO_DEBUG=1

# Hosts permitidos, separados por vírgula. Padrão: * em debug, localhost fora dele.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Caminho do SQLite operacional (jobs e locks). Padrão: operacional.sqlite3 na raiz.
# OPERATIONAL_DB_PATH=operacional.sqlite3

# --- CLI e binário nativo (opcional) ----------------------------------------------------

# Desliga a verificação automática de atualização do binário nativo (1/true/sim/yes).
# NOTION_AUTOMACOES_NO_UPDATE=

# Pasta dos backups em JSON que as operações destrutivas deixam. Padrão: pasta de estado
# do usuário (`~/.local/state/notion-automacoes/backups` em Linux e macOS).
# NOTION_AUTOMACOES_BACKUP_DIR=
